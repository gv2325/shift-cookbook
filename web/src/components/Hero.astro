---
import { IMAGES } from '../data/story';
---

<section
  aria-labelledby="hero-title"
  class="relative flex h-[calc(100svh-80px)] min-h-[560px] items-center justify-center overflow-hidden bg-navy-500 text-white"
>
  <img
    src={IMAGES.cover.src}
    alt={IMAGES.cover.alt}
    class="absolute inset-0 h-full w-full object-cover object-[center_60%]"
    fetchpriority="high"
    decoding="async"
  />
  <div aria-hidden="true" class="absolute inset-0 bg-navy-500/50"></div>

  <div class="relative z-10 space-y-2 px-12 text-center [text-shadow:0_2px_16px_rgba(0,0,0,0.35)]">
    <h1 id="hero-title" class="font-display text-7xl lg:text-[7.675rem] lg:leading-none">SHIFT</h1>
    <p class="text-base font-bold tracking-widest uppercase lg:text-xl">Streets that move cities</p>
  </div>

  <a href="#how" class="absolute bottom-5 flex flex-col items-center gap-4 text-white no-underline">
    <svg class="h-4 w-4 motion-safe:animate-bounce" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <path d="M8 2v11M3 8l5 5 5-5"></path>
    </svg>
    <span class="text-xxs font-bold uppercase">Scroll to explore</span>
  </a>

  <p class="absolute right-6 bottom-4 hidden text-xxs font-light sm:block">{IMAGES.cover.credit}</p>
</section>
