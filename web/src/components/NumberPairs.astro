---
interface Pair {
  question: string;
  items: { value: string; city: string }[];
}

interface Props {
  pairs: Pair[];
  source: string;
}

const { pairs, source } = Astro.props;
---

<div class="flex flex-col gap-4">
  {
    pairs.map((p) => (
      <div class="flex flex-col gap-3 border border-navy-500 bg-white p-6">
        <p class="text-sm font-light">{p.question}</p>
        <dl class="m-0 grid grid-cols-2 gap-6">
          {p.items.map((it) => (
            <div class="flex flex-col-reverse gap-0.5">
              <dt class="text-xs font-bold uppercase">{it.city}</dt>
              <dd class="m-0 font-display text-4xl leading-tight whitespace-nowrap sm:text-5xl">{it.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    ))
  }
  <p class="text-xs font-light">{source}</p>
</div>
