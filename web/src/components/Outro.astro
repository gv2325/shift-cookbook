---
import { STORY } from '../data/story';
---

<section aria-label="Keep going" class="px-6 pb-40">
  <div data-reveal class="mx-auto grid max-w-[1232px] gap-12 lg:grid-cols-12 lg:gap-6">
    <a href={STORY.url} class="group flex flex-col justify-between gap-8 bg-yellow-700 p-6 text-navy-500 no-underline lg:col-span-5 xl:col-span-4 xl:col-start-2">
      <span class="flex flex-col gap-8">
        <span class="font-display text-4xl">Continue learning.</span>
        <span>Read the full story by WRI India’s Geo Analytics team, with interactive charts on road hierarchy, connectivity and density for all 20 cities.</span>
      </span>
      <span class="flex justify-end" aria-hidden="true">
        <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 8h11M9 4l4 4-4 4"></path></svg>
      </span>
    </a>

    <div class="flex flex-col justify-between gap-8 bg-navy-500 p-6 text-white lg:col-span-5 lg:col-start-8 xl:col-span-4 xl:col-start-8">
      <span class="flex flex-col gap-8">
        <span class="font-display text-4xl">Explore map.</span>
        <span>Compare transit, modal share, traffic and road safety across 20 Indian cities, and take the numbers into Claude or ChatGPT.</span>
      </span>
      <span class="self-start rounded-3xl bg-white px-2.5 py-1 text-xs font-bold text-navy-500 uppercase">Coming soon</span>
    </div>
  </div>
</section>
