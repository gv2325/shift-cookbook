{
  "name": "shift-mcp",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Read-only, stateless MCP server for SHIFT city transport data (Streamable HTTP).",
  "engines": {
    "node": ">=22.23.4 <25"
  },
